NODE_ENV=development
PORT=8000
DATABASE_URL=mongodb://127.0.0.1:27017/planboard

JWT_SECRET_KEY=replace_with_long_random_hex
JWT_REFRESH_KEY=replace_with_long_random_hex
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=61d

NODE_MAIL_EMAIL_CLIENT=smtp.example.com
NODE_MAIL_EMAIL=you@example.com
NODE_MAIL_PASS=your_app_password

UPLOAD_FOLDER=public/images
APP_NAME=Planboard
ENDPOINT_SECRET=replace_me
# Frontend origin used in invite emails / credential login links
LOCAL_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER_NAME=planboard

ADMIN_EMAIL=admin@example.com
ADMIN_PASS=change_me
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASS=change_me

# Stripe (optional — product is free; stub only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase admin (optional — push notifications)
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com
